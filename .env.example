COMPOSE_PROJECT_NAME=so101-ros2-vla
SO101_IMAGE=so101-ros2-vla:jazzy
INSTALL_ML=true
# CPU example. For CUDA, choose the index compatible with the host GPU/driver.
TORCH_INDEX=https://download.pytorch.org/whl/cpu
ROS_DOMAIN_ID=42
# Send through Fast DDS background threads instead of blocking control callbacks.
RMW_FASTRTPS_PUBLICATION_MODE=ASYNCHRONOUS
# Set GPU=1 with a compatible NVIDIA driver and Container Toolkit.
GPU=0
# One container: desktop, ROS control, recording, training and inference.
GUI_ROS_IMAGE=ros:jazzy-ros-base-noble
DEV_UID=1000
DEV_GID=1000
SO101_DIALOUT_GID=20
SO101_VIDEO_GID=44
GUI_HTTP_PORT=6080
VNC_GEOMETRY=1600x900
GUI_TIMEZONE=UTC
# Desktop software rendering is independent of CUDA training/inference.
GUI_SOFTWARE_RENDERING=1
# Bound per-process CPU math pools so model initialization does not consume all cores.
SO101_CPU_THREADS=2

# Optional: override when migrating an existing desktop home volume.
SO101_HOME_VOLUME=so101-ros2-vla-home
