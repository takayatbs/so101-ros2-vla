# Desktop defaults only: user changes in dconf remain authoritative.
[org.mate.interface]
gtk-theme='Yaru-MATE-light'
icon-theme='Yaru-MATE-light'
font-name='Ubuntu 11'
document-font-name='Ubuntu 11'
monospace-font-name='Ubuntu Mono 12'
gtk-decoration-layout=':minimize,maximize,close'

[org.mate.Marco.general]
theme='Yaru'
titlebar-font='Ubuntu Medium 11'
button-layout=':minimize,maximize,close'
compositing-manager=true

[org.mate.panel]
default-layout='physical-ai'

[org.mate.background]
picture-filename='/usr/share/backgrounds/ubuntu-mate-common/Green-Wall-Logo.png'
picture-options='zoom'

[org.mate.font-rendering]
antialiasing='grayscale'
hinting='slight'

[org.mate.peripherals-mouse]
cursor-theme='Yaru'
cursor-size=24

[org.mate.applications-terminal]
exec='mate-terminal'
exec-arg='-x'

# No Unix login password is set in this container. Authenticate via VNC/SSH.
[org.mate.screensaver]
lock-enabled=false
idle-activation-enabled=false
