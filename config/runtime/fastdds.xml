<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!-- 640x480 RGB images exceed Fast DDS's default 512 KiB SHM segment.
       Keep several complete images available while asynchronous readers run. -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>so101_shm</transport_id>
      <type>SHM</type>
      <segment_size>67108864</segment_size>
      <maxMessageSize>2097152</maxMessageSize>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>so101_local_udp</transport_id>
      <type>UDPv4</type>
      <sendBufferSize>4194304</sendBufferSize>
      <receiveBufferSize>4194304</receiveBufferSize>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="so101_large_images" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>so101_shm</transport_id>
        <transport_id>so101_local_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
